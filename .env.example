# Postgres. docker compose up db exposes it on 5433.
DATABASE_URL=postgresql://buyer:buyer@localhost:5433/buyer_agent

# Any litellm model id. Set the key for the provider you pick.
LLM_MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=
# LLM_MODEL=gpt-5.1            with OPENAI_API_KEY=
# LLM_MODEL=gemini/gemini-3.5-flash  with GEMINI_API_KEY=  (used for eval/results)
# LLM_MODEL=ollama_chat/qwen2.5:14b  (local, no key)

# Executable plans above this spend wait for a buyer.
AUTO_APPROVE_LIMIT=1000
